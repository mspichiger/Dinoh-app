PORT=4000
CORS_ORIGIN=http://localhost:4200

# PostgreSQL
PGHOST=rkalvdinoh.kau.roche.com
PGPORT=5432
PGDATABASE=dinoh
PGUSER=dinoh
PGPASSWORD=replace-me
PGSSL=true

# --- Google OAuth (ID token verification) ---
# Set AUTH_ENABLED=false to bypass auth during local dev.
# Create an OAuth Client (Web application) here: https://console.cloud.google.com/apis/credentials
# Add http://localhost:4200 to "Authorized JavaScript origins".
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id.apps.googleusercontent.com
# Optional: restrict login to a single Google Workspace domain (e.g. roche.com)
GOOGLE_ALLOWED_HD=roche.com

